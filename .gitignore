# ===================================================================
# Archivo .gitignore para un proyecto multi-módulo de Java con Maven
# Ubicación: /votaciones-microservices/.gitignore
# ===================================================================

# Archivos de log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Directorios de build generados por Maven/Gradle
target/
build/
out/

# Artefactos empaquetados
*.jar
*.war
*.ear
*.zip
*.tar.gz

# Archivos del IDE
# IntelliJ
.idea/
*.iml
*.iws

# Eclipse
.classpath
.project
.settings/

# VS Code / Cursor
.vscode/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
.nb-gradle/

# Archivos del sistema operativo
# Mac
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Archivos de configuración local (nunca deben subirse al repo)
application-local.properties
application-local.yml