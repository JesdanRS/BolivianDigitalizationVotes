	"item": [
		{
			"name": "1. Autenticación Keycloak",
			"item": [
				{
					"name": "Obtener Token - ADMIN",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Guardar el token automáticamente",
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set(\"admin_token\", jsonData.access_token);",
									"    console.log(\"Token ADMIN guardado exitosamente\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "client_id",
									"value": "votaciones-client",
									"type": "text"
								},
								{
									"key": "username",
									"value": "admin",
									"type": "text"
								},
								{
									"key": "password",
									"value": "admin123",
									"type": "text"
								},
								{
									"key": "grant_type",
									"value": "password",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "http://localhost:8180/auth/realms/votaciones-realm/protocol/openid-connect/token",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8180",
							"path": [
								"auth",
								"realms",
								"votaciones-realm",
								"protocol",
								"openid-connect",
								"token"
							]
						},
						"description": "Obtiene un token JWT para el usuario ADMIN. El token se guarda automáticamente en la variable de entorno 'admin_token'."
					},
					"response": []
				},
				{
					"name": "Obtener Token - USER",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Guardar el token automáticamente",
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set(\"user_token\", jsonData.access_token);",
									"    console.log(\"Token USER guardado exitosamente\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "client_id",
									"value": "votaciones-client",
									"type": "text"
								},
								{
									"key": "username",
									"value": "user",
									"type": "text"
								},
								{
									"key": "password",
									"value": "user123",
									"type": "text"
								},
								{
									"key": "grant_type",
									"value": "password",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "http://localhost:8180/auth/realms/votaciones-realm/protocol/openid-connect/token",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8180",
							"path": [
								"auth",
								"realms",
								"votaciones-realm",
								"protocol",
								"openid-connect",
								"token"
							]
						},
						"description": "Obtiene un token JWT para el usuario USER. El token se guarda automáticamente en la variable de entorno 'user_token'."
					},
					"response": []
				}
			],
			"description": "Endpoints para obtener tokens JWT de Keycloak"
		},
